# Documentation only. Do not put real values in this file.
# Set real values in Supabase project secrets, never in GitHub Pages code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server-side secrets belong in Supabase Edge Function secrets only:
PAYPAL_CLIENT_ID=SET_IN_SUPABASE_SECRETS
PAYPAL_CLIENT_SECRET=SET_IN_SUPABASE_SECRETS
PAYPAL_WEBHOOK_ID=SET_IN_SUPABASE_SECRETS
STRIPE_SECRET_KEY=SET_IN_SUPABASE_SECRETS
STRIPE_WEBHOOK_SECRET=SET_IN_SUPABASE_SECRETS
RESEND_API_KEY=SET_IN_SUPABASE_SECRETS
TWILIO_ACCOUNT_SID=SET_IN_SUPABASE_SECRETS
TWILIO_AUTH_TOKEN=SET_IN_SUPABASE_SECRETS
TWILIO_FROM_NUMBER=SET_IN_SUPABASE_SECRETS
STORE_NOTIFICATION_EMAIL=SET_IN_SUPABASE_SECRETS
STORE_NOTIFICATION_PHONE=SET_IN_SUPABASE_SECRETS
